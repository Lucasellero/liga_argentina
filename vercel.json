{
  "outputDirectory": "docs",
  "redirects": [
    { "source": "/", "destination": "/liga_nacional/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.csv",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
